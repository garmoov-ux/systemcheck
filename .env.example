# SystemCheck 환경변수 설정 예시 (.env.example)
# 실제 운영 시 본 파일을 .env 로 복사하여 값을 조정할 수 있습니다.

# 로컬 데이터베이스 파일 경로 (기본값: ./data/app.db)
SYSTEMCHECK_DB_PATH=./data/app.db

# 장비 목록 파일(data.csv) 폴더 경로 (기본값: ./check)
SYSTEMCHECK_CHECK_DIR=./check

# 일별 로그 저장 폴더 경로 (기본값: ./log)
SYSTEMCHECK_LOG_DIR=./log

# 센터 생존신호(KeepAlive) 전송 기본 주소
SYSTEMCHECK_KEEPALIVE_URL=http://192.168.9.113:8088/api/v2/KeepAlive

# 장비 점검 주기 (초, 기본값: 100)
SYSTEMCHECK_INTERVAL_SEC=100

# 동시 병렬 점검 장비 수 (기본값: 15)
SYSTEMCHECK_CONCURRENCY=15
